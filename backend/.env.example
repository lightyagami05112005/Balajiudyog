# Balaji Udhyog lead backend — copy to ".env" and set values.
PORT=4000

# Admin dashboard token (REQUIRED — change this):
ADMIN_TOKEN=change-me-to-a-long-random-string

# WhatsApp number for click-to-chat follow-up (digits only, with country code):
WHATSAPP_NUMBER=919800000000

# Email notifications (optional — leave blank to disable):
NOTIFY_EMAIL=export@balajiudhyog.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=export@balajiudhyog.com
