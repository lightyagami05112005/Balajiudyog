# Copy this file to ".env" and paste your Leonardo API key.
# Get a key at: https://app.leonardo.ai  →  Settings → API Access
LEONARDO_API_KEY=your-leonardo-api-key-here

# Optional overrides (defaults live in leonardo-config.js):
# LEONARDO_ENGINE=photoreal     # photoreal | phoenix | kino | sdxl
# LEONARDO_MODEL=visionXL       # visionXL | diffusionXL | albedoXL | kinoXL | phoenix
# LEONARDO_GUIDANCE=7           # 1–20 (task target 7–9)
# LEONARDO_CONCURRENCY=3
# LEONARDO_WEBP_Q=80
# LEONARDO_ALCHEMY=true
