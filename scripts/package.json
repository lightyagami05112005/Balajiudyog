{
  "name": "balaji-udhyog-leonardo-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automated Leonardo AI image generation pipeline for the Balaji Udyog export website.",
  "engines": { "node": ">=18" },
  "scripts": {
    "generate": "node generate-leonardo-images.js",
